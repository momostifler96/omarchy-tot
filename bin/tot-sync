# t key [printf args...] — message in UI_LANG, falling back to English.
t() {
  local key=$1; shift
  local fmt=${M[$UI_LANG.$key]:-${M[en.$key]:-$key}}
  # shellcheck disable=SC2059
  printf "$fmt" "$@"
}

mkdir -p "$NOTES_DIR" "$BACKUP_DIR" "$STATE_DIR"
# Tighten folders created world-readable by older versions.
chmod 700 "$NOTES_DIR" "$BACKUP_DIR" "$STATE_DIR"
[[ -d $CONF_DIR ]] && chmod 700 "$CONF_DIR"
[[ -f $CONF ]] && chmod 600 "$CONF"
find "$BACKUP_DIR" -maxdepth 1 -type f -name 'tot-*.tar.gz' -exec chmod 600 -- {} +

die() { echo "tot-sync: $*" >&2; exit 1; }

json_escape() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/ }; printf '%s' "$s"; }

write_status() { # state message
  local tmp="$STATUS_FILE.tmp"
  printf '{"state":"%s","time":%s,"remote":"%s","message":"%s"}\n' \
    "$1" "$(date +%s)" "$(json_escape "$REMOTE")" "$(json_escape "$2")" >"$tmp"
  mv -f "$tmp" "$STATUS_FILE"
}

notify_error() {
  command -v notify-send >/dev/null && notify-send -u critical "$(t notify_title)" "$1"
}

require_remote() {
  [[ -n $REMOTE ]] || die "$(t no_remote)"
}

save_conf() {
  mkdir -p "$CONF_DIR"
  chmod 700 "$CONF_DIR"
  # The file is sourced on every run: quote values so a folder name typed in
  # the wizard can never be read back as shell code.
  {
    echo "# Quick Note cloud sync (read by ~/.local/bin/tot-sync)"
    echo "# rclone remote + folder, e.g. tot-gdrive:QuickNote, tot-s3:my-bucket/tot, tot-ftp:tot"
    printf 'REMOTE=%q\n' "$REMOTE"
    echo "# Local snapshots kept in $BACKUP_DIR"
    printf 'LOCAL_BACKUP_KEEP=%q\n' "$LOCAL_BACKUP_KEEP"
    echo "# Cloud snapshots older than this are deleted"
    printf 'REMOTE_BACKUP_KEEP_DAYS=%q\n' "$REMOTE_BACKUP_KEEP_DAYS"
    echo "# Extra rclone bisync flags (e.g. \"--compare size\" for FTP servers without mtime)"
    printf 'BISYNC_EXTRA=%q\n' "$BISYNC_EXTRA"
  } >"$CONF"
  chmod 600 "$CONF"
}

bisync_marker() { echo "$STATE_DIR/bisync-$(printf '%s' "$REMOTE" | md5sum | cut -c1-12)"; }

# --force: with only a note or two, a single edit changes "all files", which
# bisync would otherwise abort on. Daily snapshots + conflict copies cover us.

# ---- sync -----------------------------------------------------------------

run_bisync() { # extra flags...
  # shellcheck disable=SC2086
  "$RCLONE" bisync "$NOTES_DIR" "$REMOTE/notes" \
    --include "*.md" \
    --create-empty-src-dirs \
    --conflict-resolve newer --conflict-loser num \
    --conflict-suffix conflict --suffix-keep-extension \
    --resilient --recover --max-lock 5m \
    --force \
    $BISYNC_EXTRA "$@" 2>&1
}

cmd_sync() {
  if [[ -z $REMOTE ]]; then
    write_status "off" "$(t status_off)"
    return 0
  fi

  exec 9>"$LOCK"
  flock -n 9 || { echo "tot-sync: $(t busy)"; return 0; }

  write_status "syncing" ""
  local marker out rc
  marker=$(bisync_marker)

  if [[ -f $marker ]]; then
    out=$(run_bisync); rc=$?
    # State lost or corrupted: rebuild it, merging both sides (newest wins).
    if ((rc != 0)) && grep -qi "resync" <<<"$out"; then
      out=$(run_bisync --resync --resync-mode newer); rc=$?
    fi
  else
    "$RCLONE" mkdir "$REMOTE/notes" >/dev/null 2>&1
    out=$(run_bisync --resync --resync-mode newer); rc=$?
    ((rc == 0)) && touch "$marker"
  fi

  if ((rc == 0)); then
    write_status "ok" ""
    t sync_ok "$REMOTE"; echo
  else
    local msg
    msg=$(grep -iE "error|failed" <<<"$out" | tail -1)
    [[ -n $msg ]] || msg=$(tail -1 <<<"$out")
    msg=$(sed -E 's/^[0-9\/]+ [0-9:]+ [A-Z]+ *: *//; s/\x1b\[[0-9;]*m//g' <<<"$msg")
    write_status "error" "$msg"
    notify_error "$msg"
    echo "$out" >&2
    return 1
  fi
}

# ---- backups --------------------------------------------------------------

cmd_backup() {
  local name="tot-$(date +%Y%m%d-%H%M%S).tar.gz"
  tar -czf "$BACKUP_DIR/$name" -C "$NOTES_DIR" --exclude='*.tmp' . || die "$(t archive_fail)"
  t local_backup "$BACKUP_DIR/$name"; echo

  # Local retention
  ls -1t "$BACKUP_DIR"/tot-*.tar.gz 2>/dev/null | tail -n +$((LOCAL_BACKUP_KEEP + 1)) | xargs -r rm -f

  if [[ -n $REMOTE ]]; then
    if "$RCLONE" copyto "$BACKUP_DIR/$name" "$REMOTE/backups/$name" 2>&1; then
      t cloud_backup "$REMOTE/backups/$name"; echo
      "$RCLONE" delete "$REMOTE/backups" --min-age "${REMOTE_BACKUP_KEEP_DAYS}d" --include "tot-*.tar.gz" >/dev/null 2>&1
    else
      notify_error "$(t upload_fail "$REMOTE")"
      return 1
    fi
  fi
}

cmd_backups() {
  t list_local "$BACKUP_DIR"; echo
  ls -1t "$BACKUP_DIR"/tot-*.tar.gz 2>/dev/null | xargs -r -n1 basename
  if [[ -n $REMOTE ]]; then
    t list_cloud "$REMOTE/backups"; echo
    "$RCLONE" lsf "$REMOTE/backups" --include "tot-*.tar.gz" 2>/dev/null | sort -r
  fi
}

cmd_restore() {
  local want=${1:-latest} file=""
  if [[ $want == latest ]]; then
    file=$(ls -1t "$BACKUP_DIR"/tot-*.tar.gz 2>/dev/null | head -1)
    if [[ -z $file && -n $REMOTE ]]; then
      want=$("$RCLONE" lsf "$REMOTE/backups" --include "tot-*.tar.gz" 2>/dev/null | sort -r | head -1)
    fi
  fi
  if [[ -z $file ]]; then
    [[ -n $want && $want != latest ]] || die "$(t no_backup)"
    if [[ -f $BACKUP_DIR/$want ]]; then
      file="$BACKUP_DIR/$want"
    else
      require_remote
      "$RCLONE" copyto "$REMOTE/backups/$want" "$BACKUP_DIR/$want" || die "$(t backup_missing "$want")"
      file="$BACKUP_DIR/$want"
    fi
  fi

  t safety; echo
  cmd_backup >/dev/null
  tar -xzf "$file" -C "$NOTES_DIR" --touch || die "$(t restore_fail)"
  t restored "$(basename "$file")"; echo
  [[ -n $REMOTE ]] && cmd_sync
}

# ---- setup ----------------------------------------------------------------

ask() { # prompt [default] -> REPLY
  local prompt=$1 def=${2:-}
  if [[ -n $def ]]; then read -rp "$prompt [$def] : " REPLY; REPLY=${REPLY:-$def}
  else read -rp "$prompt : " REPLY; fi
}

ask_secret() { read -rsp "$1 : " REPLY; echo; }

cmd_setup() {
  local kind=${1:-} name folder
  if [[ -z $kind ]]; then
    t where; echo
    echo "  1) Google Drive"
    echo "  2) S3 (AWS, Cloudflare R2, Backblaze B2, Wasabi, MinIO…)"
    echo "  3) FTP / FTPS"
    echo "  4) $(t opt_other)"
    ask "$(t choice)" 1
    case $REPLY in 1) kind=google ;; 2) kind=s3 ;; 3) kind=ftp ;; *) kind=custom ;; esac
  fi

  case $kind in
  google | gdrive)
    name=tot-gdrive
    t google_info; echo
    "$RCLONE" config create "$name" drive scope drive.file || die "$(t setup_fail "Google Drive")"
    ask "$(t folder) (Google Drive)" "QuickNote"
    folder=$REPLY
    ;;
  s3)
    name=tot-s3
    t providers; echo
    ask "$(t provider)" "AWS"; local provider=$REPLY
    ask "Access key ID"; local key=$REPLY
    ask_secret "Secret access key"; local secret=$REPLY
    ask "$(t region)" "us-east-1"; local region=$REPLY
    ask "$(t endpoint)" ""; local endpoint=$REPLY
    ask "Bucket"; local bucket=$REPLY
    ask "$(t folder) (bucket)" "tot"; local prefix=$REPLY
    local args=(provider "$provider" access_key_id "$key" secret_access_key "$secret" region "$region")
    [[ -n $endpoint ]] && args+=(endpoint "$endpoint")
    "$RCLONE" config create "$name" s3 "${args[@]}" --non-interactive >/dev/null || die "$(t setup_fail S3)"
    folder="$bucket/$prefix"
    "$RCLONE" mkdir "$name:$bucket" >/dev/null 2>&1
    ;;
  ftp)
    name=tot-ftp
    ask "$(t host)"; local host=$REPLY
    ask "Port" "21"; local port=$REPLY
    ask "$(t user)"; local user=$REPLY
    ask_secret "$(t password)"; local pass=$REPLY
    ask "$(t tls)" "$(t yes)"; local tls=false
    [[ ${REPLY,,} == "$(t yes)"* || ${REPLY,,} == y* ]] && tls=true
    "$RCLONE" config create "$name" ftp host "$host" port "$port" user "$user" pass "$pass" \
      explicit_tls "$tls" --non-interactive >/dev/null || die "$(t setup_fail FTP)"
    ask "$(t folder)" "tot"
    folder=$REPLY
    # Many FTP servers can't set modification times; compare by size then.
    BISYNC_EXTRA="--compare size"
    ;;
  custom)
    t remotes; echo
    "$RCLONE" listremotes
    ask "$(t remote_name)"
    name=${REPLY%:}
    ask "$(t folder)" "QuickNote"
    folder=$REPLY
    ;;
  *) die "$(t unknown_kind "$kind")" ;;
  esac

  REMOTE="$name:$folder"
  t testing "$REMOTE"; echo
  "$RCLONE" mkdir "$REMOTE" || die "$(t no_access "$REMOTE")"
  save_conf
  t conf_saved "$CONF"; echo

  t first_sync; echo
  rm -f "$(bisync_marker)"
  cmd_sync || exit 1
  cmd_backup
  cmd_enable
  echo
  t done; echo
}

# ---- automation -----------------------------------------------------------

UNIT_DIR="$HOME/.config/systemd/user"

cmd_enable() {
  mkdir -p "$UNIT_DIR"
  local bin="$HOME/.local/bin/tot-sync"

  cat >"$UNIT_DIR/tot-sync.service" <<EOF
[Unit]
Description=Quick Note cloud sync

[Service]
Type=oneshot
ExecStart=$bin sync
EOF

  # Saves arrive every few hundred ms while typing: wait, then sync once.
  cat >"$UNIT_DIR/tot-sync-debounced.service" <<EOF
[Unit]
Description=Quick Note cloud sync (after edits)

[Service]
Type=oneshot
ExecStartPre=/usr/bin/sleep 20
ExecStart=$bin sync
EOF

  cat >"$UNIT_DIR/tot-sync.timer" <<EOF
[Unit]
Description=Quick Note cloud sync every 5 minutes

[Timer]
OnBootSec=1min
OnUnitActiveSec=5min
Unit=tot-sync.service

[Install]
WantedBy=timers.target
EOF

  cat >"$UNIT_DIR/tot-sync.path" <<EOF
[Unit]
Description=Sync Quick Note notes when they change

[Path]
PathChanged=$NOTES_DIR
Unit=tot-sync-debounced.service

[Install]
WantedBy=default.target
EOF

  cat >"$UNIT_DIR/tot-backup.service" <<EOF
[Unit]
Description=Quick Note backup

[Service]
Type=oneshot
ExecStart=$bin backup
EOF

  cat >"$UNIT_DIR/tot-backup.timer" <<EOF
[Unit]
Description=Daily Quick Note backup

[Timer]
OnCalendar=daily
Persistent=true
RandomizedDelaySec=10min

[Install]
WantedBy=timers.target
EOF

  systemctl --user daemon-reload
  systemctl --user enable --now tot-sync.timer tot-sync.path tot-backup.timer >/dev/null 2>&1
  t enabled; echo
}

cmd_disable() {
  systemctl --user disable --now tot-sync.timer tot-sync.path tot-backup.timer >/dev/null 2>&1
  t disabled; echo
}

cmd_status() {
  local count
  count=$(ls -1 "$BACKUP_DIR"/tot-*.tar.gz 2>/dev/null | wc -l)
  printf '%-17s: %s\n' "$(t st_cloud)" "${REMOTE:-$(t not_configured)}"
  printf '%-17s: %s\n' "$(t st_notes)" "$NOTES_DIR"
  printf '%-17s: %s (%s)\n' "$(t st_backups)" "$BACKUP_DIR" "$(t st_local "$count")"
  [[ -f $STATUS_FILE ]] && printf '%-17s: %s\n' "$(t st_last)" "$(cat "$STATUS_FILE")"
  for u in tot-sync.timer tot-sync.path tot-backup.timer; do
    printf '%-17s: %s\n' "$u" "$(systemctl --user is-active "$u" 2>/dev/null)"
  done
}

case "${1:-status}" in
setup) shift; cmd_setup "$@" ;;
sync) cmd_sync ;;
backup) cmd_backup ;;
backups | list) cmd_backups ;;
restore) shift; cmd_restore "$@" ;;
enable) require_remote; cmd_enable ;;
disable) cmd_disable ;;
status) cmd_status ;;
*) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
