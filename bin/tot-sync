#!/bin/bash
# Cloud sync and backups for Quick Note (momoledev.tot shell plugin), via rclone.
#
#   tot-sync setup [google|s3|ftp|custom]  configure the cloud remote (interactive)
#   tot-sync sync                          two-way sync notes <-> cloud
#   tot-sync backup                        timestamped snapshot, local + cloud
#   tot-sync backups                       list backups
#   tot-sync restore [latest|<name>]       restore a backup (current notes are backed up first)
#   tot-sync enable | disable              automatic sync (every 5 min + on save) and daily backup
#   tot-sync status                        show configuration and last result
#
# Cloud layout: <REMOTE>/notes (synced notes), <REMOTE>/backups (snapshots).

set -uo pipefail

# Notes, snapshots, status and settings are private to the user.
umask 077

NOTES_DIR="$HOME/.local/share/omarchy-tot"
BACKUP_DIR="$HOME/.local/share/omarchy-tot-backups"
STATE_DIR="$HOME/.local/state/omarchy-tot"
STATUS_FILE="$STATE_DIR/sync.json"
CONF_DIR="$HOME/.config/omarchy-tot"
CONF="$CONF_DIR/sync.conf"
LOCK="$STATE_DIR/sync.lock"

# Defaults, overridden by sync.conf
REMOTE=""
LOCAL_BACKUP_KEEP=30
REMOTE_BACKUP_KEEP_DAYS=90
BISYNC_EXTRA=""

[[ -f $CONF ]] && source "$CONF"

RCLONE=$(command -v rclone || echo "$HOME/.local/share/mise/shims/rclone")

# ---- i18n -----------------------------------------------------------------
# Language: $TOT_LANG, else the plugin's "language" setting in shell.json,
# else English. "auto" follows $LANG. Supported: en fr es de pt.

resolve_lang() {
  local l=${TOT_LANG:-}
  if [[ -z $l ]] && command -v jq >/dev/null && [[ -f $HOME/.config/omarchy/shell.json ]]; then
    l=$(jq -r '[.bar.layout[]?[]? | select(.id == "momoledev.tot") | .language // empty][0] // empty' \
      "$HOME/.config/omarchy/shell.json" 2>/dev/null)
  fi
  l=${l:-en}
  [[ $l == auto ]] && l=${LANG:-en}
  l=${l:0:2}
  case $l in en | fr | es | de | pt) echo "$l" ;; *) echo en ;; esac
}
UI_LANG=$(resolve_lang)

